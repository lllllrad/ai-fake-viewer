    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared Bootstrap-backed action with explicit Korean labeling.",
      "html": "<button type=\"button\" class=\"ds-primary\">연결 저장</button>",
      "css": ".ds-primary{font-family:var(--font-ui,\"Noto Sans KR Variable\",system-ui,sans-serif);font-size:14px;min-height:40px;padding:6px 12px;border:1px solid;border-radius:6px;font-weight:550;display:inline-flex;align-items:center;justify-content:center;gap:7px;line-height:1.5;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out;color:white;background:var(--accent,#175cd3);border-color:var(--accent,#175cd3);}.ds-primary:hover{background:#124baa;border-color:#124baa;}.ds-primary:active{background:#0a58ca;border-color:#0a53be;}.ds-primary:focus-visible{outline:3px solid var(--accent,#175cd3);outline-offset:3px;box-shadow:none}.ds-primary:disabled{opacity:.65;cursor:not-allowed}@media(max-width:767px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared Bootstrap-backed action with explicit Korean labeling.",
      "html": "<button type=\"button\" class=\"ds-secondary\">새로고침</button>",
      "css": ".ds-secondary{font-family:var(--font-ui,\"Noto Sans KR Variable\",system-ui,sans-serif);font-size:14px;min-height:40px;padding:6px 12px;border:1px solid;border-radius:6px;font-weight:550;display:inline-flex;align-items:center;justify-content:center;gap:7px;line-height:1.5;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out;color:#40516b;background:var(--surface,#fff);border-color:#c6cfdb;}.ds-secondary:hover{background:#edf1f6;color:var(--ink,#202a39);border-color:#a7b5c8;}.ds-secondary:active{background:#e1e8f2;color:var(--ink,#202a39);}.ds-secondary:focus-visible{outline:3px solid var(--accent,#175cd3);outline-offset:3px;box-shadow:none}.ds-secondary:disabled{opacity:.65;cursor:not-allowed}@media(max-width:767px){.ds-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
