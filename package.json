{
  "name": "ai-fake-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/main.ts",
    "start": "tsx apps/server/main.ts",
    "demo": "tsx apps/server/main.ts --demo",
    "build": "tsc --noEmit && vite build && vite build --config vite.experiments.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "check": "npm run docs:check && npm run build && npm test",
    "test:browser": "tsx scripts/browser-check.ts",
    "format": "prettier --write apps packages workers scripts tests *.json *.ts *.yaml *.md research/*.md docs/**/*.md",
    "format:check": "prettier --check apps packages workers scripts tests *.json *.ts *.yaml *.md research/*.md docs/**/*.md",
    "docs:check": "tsx scripts/check-docs.ts",
    "setup:check": "tsx scripts/check-local-setup.ts",
    "test:server": "tsx scripts/server-control-check.ts",
    "experiment": "tsx scripts/experiment.ts",
    "test:experiments:browser": "tsx scripts/experiment-browser-check.ts && tsx scripts/interactive-experiment-browser-check.ts",
    "experiments:start": "tsx apps/experiments/main.ts",
    "experiments:setup": "tsx apps/experiments/setup.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "^11.2.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "bootstrap": "^5.3.8",
    "fastify": "^5.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.5",
    "socket.io-client-v2": "npm:socket.io-client@2.0.3",
    "soop-extension": "1.3.3",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "engine.io-client": "3.5.6",
    "socket.io-parser": "3.3.6"
  }
}
