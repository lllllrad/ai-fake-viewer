# Run npm run setup to generate independent random local credentials.
ADMIN_TOKEN=
READER_TOKEN=
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# YouTube automatic participation notices require BOTH OAuth client values.
# Google Cloud client type: Web application. Register the exact callback from
# config.yaml youtube.redirectUri (default http://127.0.0.1:3210/oauth/youtube/callback).
# After updating .env, restart the app and connect the broadcasting channel in admin.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional receipt credentials. Keep an existing API key; it cannot send notices.
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
# CHZZK: enable user-info lookup, chat receipt and chat sending, then reauthorize
# the broadcaster account after changing the client credentials or permissions.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
GROQ_API_KEY=
TYPESAFE_API_KEY=
